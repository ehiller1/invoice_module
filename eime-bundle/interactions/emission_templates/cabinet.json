{
  "bundle_version": "1.0",
  "tier": "declarative",
  "surface_id": "cabinet",
  "payload": {
    "root": {
      "component": "Stack",
      "props": { "gap": "md" },
      "children": [
        {
          "component": "ActionCard",
          "props": {
            "title_template": "Recommended: {recommendation.title}",
            "body_template": "{recommendation.rationale}\n\nProjected impact: {recommendation.impact_preview}",
            "actions": [
              { "id": "accept", "label": "Do it", "style": "primary" },
              { "id": "dismiss", "label": "Dismiss", "style": "default" }
            ]
          }
        },
        {
          "component": "EvidencePack",
          "props": {
            "title": "Why this recommendation",
            "summary_template": "{recommendation.evidence_summary}"
          }
        }
      ]
    }
  },
  "event_bindings": [
    {
      "binding_id": "accept_recommendation",
      "trigger_selector": "root.children[0].actions[0]",
      "cloudevent": {
        "specversion": "1.0",
        "type": "embark.surface.eime.recommendation_accepted.v1",
        "source": "/embark/surfaces/cabinet",
        "subject": "{recommendation.id}",
        "datacontenttype": "application/json",
        "data_template": { "recommendation_id": "{recommendation.id}", "actor": "{user.id}" }
      }
    }
  ],
  "provenance": {
    "agent_id": "accounting_advisor",
    "task_id": "{runtime.task_id}",
    "decision_ledger_ref": "{runtime.ledger_ref}",
    "abb_ref": null,
    "membrane_id": "mem.ein.parish.cabinet_gate",
    "perturbation_correlation_id": "{runtime.correlation_id}"
  },
  "rendering_hints": {
    "priority": "normal",
    "dismissible": true,
    "persist_until": null,
    "theme_override": null,
    "catalog_gap_note": [
      "needed: ImpactPreviewPanel — scenario/impact panel showing projected before/after deltas for a next-best-action recommendation. Fallback: projected impact folded into ActionCard body_template."
    ]
  }
}
